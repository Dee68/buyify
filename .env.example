# Development / Production environment variable template
# Copy to .env and fill the values locally. DO NOT commit .env.

# Django
DEBUG=0
SECRET_KEY=your_production_secret_key_here
ALLOWED_HOSTS=your.domain.com,localhost,127.0.0.1

# Postgres (for runtime; not used by GH Actions)
POSTGRES_USER=buyify_admin
POSTGRES_PASSWORD=very_secure_password
POSTGRES_DB=buyify_prod
DB_HOST=db
DB_PORT=5432

# Optional - Sentry / Monitoring
SENTRY_DSN=

# Other runtime vars (S3, Stripe, etc.)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# STRIPE_SECRET_KEY=
